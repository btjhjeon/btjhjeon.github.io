---
import { localizePath, type Locale } from '../i18n/config';
import { useTranslations } from '../i18n/ui';
import { meta } from '../site.config';
import LanguageSwitcher from './LanguageSwitcher.astro';
import ThemeToggle from './ThemeToggle.astro';

interface Props {
  locale: Locale;
  /** locale 접두사를 제외한 현재 논리 경로 */
  path: string;
}

const { locale, path } = Astro.props;
const t = useTranslations(locale);

const nav = [
  { key: 'nav.about' as const, path: '/' },
  { key: 'nav.projects' as const, path: '/projects/' },
];

const isCurrent = (target: string) =>
  target === '/' ? path === '/' : path.startsWith(target);
---

<header
  class="site-header sticky top-0 z-40 border-b"
  style="border-color: var(--color-border);"
>
  <div class="mx-auto flex max-w-6xl items-center justify-between gap-4 px-5 py-3 sm:px-8">
    <a
      href={localizePath(locale, '/')}
      class="group flex items-center gap-2.5 font-semibold tracking-tight no-underline"
      style="color: var(--color-fg);"
    >
      <span class="brand-mark" aria-hidden="true">J</span>
      <span>{meta[locale].title}</span>
    </a>

    <div class="flex items-center gap-2 sm:gap-3">
      <nav aria-label="Main">
        <ul class="nav-pill flex items-center gap-0.5 p-1 text-sm">
          {
            nav.map((item) => (
              <li>
                <a
                  href={localizePath(locale, item.path)}
                  aria-current={isCurrent(item.path) ? 'page' : undefined}
                  class:list={[
                    'block rounded-full px-3 py-1.5 no-underline transition-all',
                    isCurrent(item.path) ? 'nav-link-current font-semibold' : 'hover:text-[var(--color-fg)]',
                  ]}
                  style={`color: ${isCurrent(item.path) ? 'var(--color-fg)' : 'var(--color-muted)'};`}
                >
                  {t(item.key)}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>

      <div class="flex items-center gap-1.5">
        <LanguageSwitcher locale={locale} path={path} />
        <ThemeToggle locale={locale} />
      </div>
    </div>
  </div>
</header>
