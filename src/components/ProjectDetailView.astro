---
import { Image } from 'astro:assets';
import { render } from 'astro:content';
import { localizePath, type Locale } from '../i18n/config';
import { useTranslations } from '../i18n/ui';
import BaseLayout from '../layouts/BaseLayout.astro';
import { getProject } from '../utils/collections';
import ProjectMeta from './ProjectMeta.astro';

interface Props {
  locale: Locale;
  slug: string;
}

const { locale, slug } = Astro.props;
const t = useTranslations(locale);

const entry = await getProject(locale, slug);
if (!entry) throw new Error(`project "${slug}" not found for locale "${locale}"`);
const { Content } = await render(entry);
---

<BaseLayout
  locale={locale}
  path={`/projects/${slug}/`}
  title={entry.data.title}
  description={entry.data.summary}
>
  <a
    href={localizePath(locale, '/projects/')}
    class="text-sm no-underline hover:underline"
    style="color: var(--color-muted);"
  >
    ← {t('project.back')}
  </a>

  <header class="mt-4">
    <div class="flex items-start gap-4">
      {
        entry.data.logo && (
          <Image
            src={entry.data.logo}
            alt=""
            width={80}
            densities={[1, 2]}
            loading="eager"
            class="shrink-0 rounded"
          />
        )
      }
      <div class="min-w-0">
        <h1 class="text-2xl font-bold tracking-tight">{entry.data.title}</h1>
        <p class="mt-1.5 leading-relaxed" style="color: var(--color-muted);">
          {entry.data.summary}
        </p>
      </div>
    </div>

    <div class="mt-6 rounded-lg border p-4" style="border-color: var(--color-border);">
      <ProjectMeta locale={locale} data={entry.data} />
    </div>
  </header>

  {
    entry.data.cover && (
      <Image
        src={entry.data.cover}
        alt=""
        loading="lazy"
        class="mt-8 rounded-lg border"
        style="border-color: var(--color-border);"
      />
    )
  }

  <div class="prose-content mt-10">
    <Content />
  </div>
</BaseLayout>
