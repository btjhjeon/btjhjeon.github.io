---
import type { Locale } from '../i18n/config';
import { useTranslations } from '../i18n/ui';
import { formatPeriod } from '../utils/date';
import type { ProjectEntry } from '../utils/collections';

interface Props {
  locale: Locale;
  data: ProjectEntry['data'];
}

const { locale, data } = Astro.props;
const t = useTranslations(locale);

const period = formatPeriod(data.startDate, data.endDate, locale, t('project.ongoing'));

const KIND_ICON: Record<string, string> = {
  github: '⌥',
  huggingface: '🤗',
  paper: '📄',
  demo: '▶',
  blog: '✎',
  press: '📰',
  other: '↗',
};
---

<dl class="grid gap-5 text-sm sm:grid-cols-3">
  <div>
    <dt class="meta-label">{t('project.period')}</dt>
    <dd class="mt-1.5 font-semibold">{period}</dd>
  </div>

  {
    data.org && (
      <div>
        <dt class="meta-label">{t('project.org')}</dt>
        <dd class="mt-1.5 font-semibold">{data.org}</dd>
      </div>
    )
  }

  {
    data.role && (
      <div>
        <dt class="meta-label">{t('project.role')}</dt>
        <dd class="mt-1.5 font-semibold">{data.role}</dd>
      </div>
    )
  }

  {
    data.links.length > 0 && (
      <div>
        <dt class="meta-label">{t('project.links')}</dt>
        <dd class="mt-1.5">
          <ul class="flex flex-wrap gap-x-4 gap-y-1">
            {data.links.map((link) => (
              <li>
                <a href={link.url} rel="noopener" class="no-underline hover:underline">
                  <span aria-hidden="true">{KIND_ICON[link.kind] ?? KIND_ICON.other}</span>
                  {' '}{link.label}
                </a>
              </li>
            ))}
          </ul>
        </dd>
      </div>
    )
  }
</dl>

{
  data.tags.length > 0 && (
    <ul class="mt-6 flex flex-wrap gap-2">
      {data.tags.map((tag) => (
        <li class="project-tag rounded-full px-2.5 py-1 text-xs font-medium">
          {tag}
        </li>
      ))}
    </ul>
  )
}
