---
import BaseLayout from '../layouts/BaseLayout.astro';
import { useTranslations } from '../i18n/ui';

const t = useTranslations('en');
---
<BaseLayout locale="en" path="/404/" title={t('notFound.title')}>
  <h1 class="text-2xl font-bold tracking-tight">{t('notFound.title')}</h1>
  <p class="mt-3" style="color: var(--color-muted);">{t('notFound.body')}</p>
  <p class="mt-6"><a href="/">{t('notFound.home')} →</a></p>
</BaseLayout>
