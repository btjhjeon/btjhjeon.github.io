---
import { Image } from 'astro:assets';
import { render } from 'astro:content';
import { localizePath, type Locale } from '../i18n/config';
import { useTranslations } from '../i18n/ui';
import BaseLayout from '../layouts/BaseLayout.astro';
import { getProject } from '../utils/collections';
import ProjectMeta from './ProjectMeta.astro';

interface Props {
  locale: Locale;
  slug: string;
}

const { locale, slug } = Astro.props;
const t = useTranslations(locale);

const entry = await getProject(locale, slug);
if (!entry) throw new Error(`project "${slug}" not found for locale "${locale}"`);
const { Content } = await render(entry);
---

<BaseLayout
  locale={locale}
  path={`/projects/${slug}/`}
  title={entry.data.title}
  description={entry.data.summary}
  wide
>
  <div class="mx-auto max-w-4xl">
    <a
      href={localizePath(locale, '/projects/')}
      class="back-link inline-flex items-center gap-2 rounded-full px-3 py-2 text-sm font-medium no-underline"
      style="color: var(--color-muted);"
    >
      <span aria-hidden="true">←</span> {t('project.back')}
    </a>

    <header class="project-detail-hero relative mt-6 overflow-hidden rounded-[2rem] border p-6 sm:p-10 lg:p-12">
      <span class="detail-glow" aria-hidden="true"></span>
      <div class="relative">
        <div class="flex flex-col gap-6 sm:flex-row sm:items-start">
          {
            entry.data.logo && (
              <div class="detail-logo grid size-20 shrink-0 place-items-center rounded-2xl border p-2 sm:size-24">
                <Image
                  src={entry.data.logo}
                  alt=""
                  width={96}
                  densities={[1, 2]}
                  loading="eager"
                  class="max-h-full w-auto rounded-xl object-contain"
                />
              </div>
            )
          }
          <div class="min-w-0">
            <p class="eyebrow">{entry.data.role ?? t('projects.eyebrow')}</p>
            <h1 class="mt-4 text-3xl font-bold leading-tight tracking-[-0.035em] sm:text-5xl">
              {entry.data.title}
            </h1>
            <p class="mt-5 max-w-3xl text-base leading-relaxed sm:text-lg" style="color: var(--color-muted);">
              {entry.data.summary}
            </p>
          </div>
        </div>

        <div class="mt-8 border-t pt-6" style="border-color: var(--color-border);">
          <ProjectMeta locale={locale} data={entry.data} />
        </div>
      </div>
    </header>

    {
      entry.data.cover && (
        <div class="project-cover mt-8 overflow-hidden rounded-[1.5rem] border p-2">
          <Image
            src={entry.data.cover}
            alt=""
            loading="lazy"
            class="w-full rounded-[1rem]"
          />
        </div>
      )
    }

    <div class="prose-content project-prose mx-auto mt-14 max-w-3xl">
      <Content />
    </div>
  </div>
</BaseLayout>
